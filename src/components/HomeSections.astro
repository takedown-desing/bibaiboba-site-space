---
import Faq from './Faq.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site.mjs';
import { previewFor } from '../lib/previews.mjs';
import CaseCard from './CaseCard.astro';
import CaseMosaic from './CaseMosaic.astro';
interface Props { d: any }
const { d } = Astro.props;
const cases = (await getCollection('pages')).filter((p) => p.data.type === 'case').map((p) => p.data);
const featured = ['C-148', 'C-250', 'C-280'].map((id) => cases.find((c) => c.case?.id === id)).filter(Boolean);
const rest = cases.filter((c) => !featured.includes(c)).slice(0, 6);
---
<section class="wrap" style="padding-block:clamp(72px,10vw,150px) clamp(40px,6vw,80px)">
  <div class="kicker"><span>[01]</span><span><strong>Знакомьтесь</strong></span></div>
  <h2 class="section-title">{d.about_title || 'Два практика с 2018 года. Три канала заявок.'}</h2>
  <div class="hero-row">
    <p class="lede" style="font-size:clamp(18px,1.6vw,22px)">{d.about_text || d.lede}</p>
    <div class="hero-ctas"><a class="pill pill-light" href={withBase('/o-nas/')}><span class="dot"></span>О нас</a><a class="pill pill-glass" href={withBase('/audit-besplatno/')}>Бесплатный аудит</a></div>
  </div>
</section>

<section class="wrap cq" style="padding-block:clamp(40px,6vw,90px)">
  <div class="kicker"><span>[02]</span><span><strong>Кейсы Авито с цифрами из кабинета</strong></span></div>
  <h2 class="section-title">Наши проекты</h2>
  <CaseMosaic limit={7} id="home-cases" />
  <p style="margin-top:28px"><a class="pill pill-glass" href={withBase('/kejsy/')}>Все кейсы</a></p>
</section>

<section class="wrap" style="padding-block:clamp(40px,6vw,90px) clamp(56px,8vw,110px)">
  <div class="kicker"><span>[03]</span><span><strong>Чем мы занимаемся</strong></span></div>
  <div class="flow-col">
    <div class="prose flow"><slot /></div>
    <div class="sec"><Faq items={d.faq || []} /></div>
  </div>
</section>
