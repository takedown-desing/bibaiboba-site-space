---
// Первый экран внутренних страниц: кадр Меркурия из промта 2, гигантский узкий H1, строки фактов.
import Header from './Header.astro';
import { withBase } from '../lib/site.mjs';
interface Props { d: any }
const { d } = Astro.props;
const MERCURY = 'https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/d6fb8b6b-c15e-4aaa-9cf7-45bbb5e33372.jpg';
const cta = d.hero_cta || {};
---
<section class="page-hero">
  <img class="page-hero-bg" src={MERCURY} alt="" fetchpriority="high" decoding="async" />
  <Header current={d.url} />
  <div class="page-hero-inner">
    {d.breadcrumbs?.length > 1 && (
      <nav class="crumbs" aria-label="Хлебные крошки"><ol>{d.breadcrumbs.map((b, i) => <li>{i < d.breadcrumbs.length - 1 ? <a href={withBase(b.url)}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>
    )}
    <h1 class="display">{d.h1}</h1>
    <div class="hero-row">
      <div style="display:grid;gap:22px">
        {d.lede && <p class="lede">{d.lede}</p>}
        <div class="hero-ctas">
          {cta.primary && <a class="pill pill-light" href={withBase(cta.primary.href)}><span class="dot"></span>{cta.primary.label}</a>}
          {cta.secondary && <a class="pill pill-glass" href={withBase(cta.secondary.href)}>{cta.secondary.label}</a>}
        </div>
      </div>
      {d.highlights?.length > 0 && (
        <dl class="facts">{d.highlights.map((h) => <div class="fact"><dt>{h.value}</dt><dd>{h.label}</dd></div>)}</dl>
      )}
    </div>
  </div>
</section>
