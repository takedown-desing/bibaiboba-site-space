---
// Шапка варианта Space: стеклянная пилюля с выпадающими подразделами + полноэкранное меню.
import { getCollection } from 'astro:content';
import { withBase, NAV } from '../lib/site.mjs';
import Logo from './Logo.astro';
interface Props { current?: string; solid?: boolean }
const { current = '', solid = false } = Astro.props;
const cases = (await getCollection('pages')).filter((p) => p.data.type === 'case').map((p) => [p.data.url, p.data.case?.niche || p.data.h1]);
const nav = NAV.map((g) => ({ ...g, items: g.cases ? [...g.items, ...cases] : g.items }));
const isActive = (g) => current !== '/' && (current.startsWith(g.href) || g.items.some(([h]) => current === h));
---
<header class={`site-header ${solid ? 'is-solid' : ''}`}>
  <a class="brand" href={withBase('/')} aria-label="На главную">
    <Logo class="brand-mark" />
  </a>
  <div class="header-actions">
    <nav class="nav" aria-label="Основная навигация">
      <ul class="nav-list">
        {nav.map((g, i) => (
          <li class="nav-dd" data-dd>
            <a class={isActive(g) ? 'active' : ''} aria-current={current === g.href ? 'page' : undefined} href={withBase(g.href)}>{g.short}</a>
            <button type="button" class="dd-toggle" aria-expanded="false" aria-controls={`dd-${i}`} aria-label={`Подразделы: ${g.label}`}><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
            <div class="dd-panel" id={`dd-${i}`}>
              <ul class={g.items.length > 6 ? 'is-wide' : ''}>
                {g.items.map(([h, l], k) => <li><a class={current === h ? 'is-current' : ''} href={withBase(h)}><span>[{String(k + 1).padStart(2, '0')}]</span>{l}</a></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <button class="menu-btn" type="button" data-menu-open aria-expanded="false" aria-controls="menu-overlay">Меню</button>
  </div>
</header>
<div class="menu-overlay" id="menu-overlay" role="dialog" aria-modal="true" aria-label="Меню сайта">
  <div class="menu-top">
    <a class="brand" href={withBase('/')} aria-label="На главную"><Logo class="brand-mark" /></a>
    <button class="menu-btn" type="button" data-menu-close>Закрыть</button>
  </div>
  <div class="menu-grid">
    {nav.map((g) => (
      <details class="menu-group" open>
        <summary><h2>{g.label}</h2></summary>
        <ul>{g.items.map(([h, t]) => <li><a href={withBase(h)}>{t}</a></li>)}</ul>
      </details>
    ))}
  </div>
  <p style="margin-top:40px"><a class="pill pill-light" href={withBase('/audit-besplatno/')}><span class="dot"></span>Бесплатный экспресс-аудит</a></p>
</div>
<script>
  const ov = document.getElementById('menu-overlay');
  const openBtn = document.querySelector('[data-menu-open]');
  const open = () => { ov.classList.add('is-open'); openBtn.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; ov.querySelector('a')?.focus(); };
  const close = () => { ov.classList.remove('is-open'); openBtn.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; openBtn.focus(); };
  openBtn?.addEventListener('click', open);
  document.querySelector('[data-menu-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && ov.classList.contains('is-open')) close(); });
  // на телефоне группы меню свёрнуты, на десктопе раскрыты
  if (matchMedia('(max-width: 900px)').matches) ov.querySelectorAll('details.menu-group').forEach((d) => d.removeAttribute('open'));
  const dds = [...document.querySelectorAll('[data-dd]')];
  const shut = (except) => dds.forEach((dd) => { if (dd !== except) { dd.classList.remove('open'); dd.querySelector('.dd-toggle')?.setAttribute('aria-expanded', 'false'); } });
  dds.forEach((dd) => {
    const btn = dd.querySelector('.dd-toggle');
    btn?.addEventListener('click', (e) => { e.stopPropagation(); const on = !dd.classList.contains('open'); shut(dd); dd.classList.toggle('open', on); btn.setAttribute('aria-expanded', String(on)); });
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest?.('[data-dd]')) shut(null); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(null); });
</script>
